# ============================================================
# DJ SHAGGY — Environment template
# Copy the keys you need into Vercel → Project → Environment Variables
# (or .env for local dev). NEVER expose these in the frontend.
# ============================================================

# ---- Supabase (already configured by the platform) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Transactional email (Resend) ----
# Sign up at resend.com, create an API key, verify your sending domain.
# Without these, emails are skipped gracefully (orders still work) and the
# admin is shown a clear "email not sent" notice after approvals.
RESEND_API_KEY=
RESEND_FROM=DJ SHAGGY <orders@yourdomain.com>

# ---- Google Drive import ----
# Parent folder that contains one sub-folder per playlist.
GOOGLE_DRIVE_FOLDER_ID=
# Option A (simple): API key. Parent folder must be shared "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
# Option B (better): Service account JSON (entire file contents on one line).
# Share the parent folder with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- AI chatbot (optional, OpenAI-compatible) ----
# Without a key, the chatbot uses the built-in catalogue-aware assistant
# (real data, rule-based — it never invents products or prices).
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Future payment gateway (Razorpay) — reserved ----
# Manual UPI is the active payment system. These are reserved for the future
# gateway module; the order/payment architecture is already modular for it.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
