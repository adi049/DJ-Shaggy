# DJ SHAGGY — Local + Hostinger Node.js environment
# Copy this file to .env for local development. Never commit real secrets.
# Hostinger: add the same values in the Node.js app environment variables.

# Supabase public project URL (same value for both URL variables)
NEXT_PUBLIC_SUPABASE_URL=
VITE_SUPABASE_URL=

# Supabase publishable/anon key: frontend only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Supabase service_role/secret key: SERVER ONLY. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional transactional email
RESEND_API_KEY=
RESEND_FROM=DJ SHAGGY <orders@yourdomain.com>

# Optional Google Drive import
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional AI assistant
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Node server
PORT=8787
